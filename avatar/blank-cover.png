<svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
    width="500" height="500" viewBox="0 0 500 500">
    <defs>
        <!-- 深蓝渐变背景 -->
        <radialGradient id="bgGrad" cx="50%" cy="45%" r="75%">
            <stop offset="0%" stop-color="#123a7a"/>
            <stop offset="45%" stop-color="#0a2350"/>
            <stop offset="100%" stop-color="#030b1a"/>
        </radialGradient>

        <!-- 蓝色发光滤镜 -->
        <filter id="glow" x="-60%" y="-60%" width="220%" height="220%">
            <feGaussianBlur stdDeviation="10" result="blur1"/>
            <feGaussianBlur stdDeviation="22" result="blur2"/>
            <feMerge>
                <feMergeNode in="blur2"/>
                <feMergeNode in="blur1"/>
                <feMergeNode in="SourceGraphic"/>
            </feMerge>
        </filter>

        <!-- 菱形填充渐变 -->
        <linearGradient id="diamondFill" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#4da3ff"/>
            <stop offset="50%" stop-color="#1f6fe0"/>
            <stop offset="100%" stop-color="#0b3c91"/>
        </linearGradient>

        <linearGradient id="diamondFill2" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#6bbcff"/>
            <stop offset="55%" stop-color="#2b82ff"/>
            <stop offset="100%" stop-color="#0a2f7a"/>
        </linearGradient>

        <style>
            /* 所有菱形层都绕画布中心 (250,250) 旋转 */
            .layer {
                transform-origin: 250px 250px;
                animation-name: spin;
                animation-timing-function: linear;
                animation-iteration-count: infinite;
            }

            /* 顺时针 */
            @keyframes spin {
                from { transform: rotate(0deg); }
                to   { transform: rotate(360deg); }
            }

            /* 逆时针 */
            @keyframes spinReverse {
                from { transform: rotate(360deg); }
                to   { transform: rotate(0deg); }
            }

            /* 四层不同速度、不同方向 */
            .layer1 {
                animation-duration: 24s;
                animation-name: spin;
            }
            .layer2 {
                animation-duration: 16s;
                animation-name: spinReverse;
            }
            .layer3 {
                animation-duration: 10s;
                animation-name: spin;
            }
            .layer4 {
                animation-duration: 6s;
                animation-name: spinReverse;
            }
        </style>
    </defs>

    <!-- 500x500 深蓝背景 -->
    <rect x="0" y="0" width="500" height="500" fill="url(#bgGrad)"/>

    <g stroke="none" stroke-miterlimit="10">

        <!-- 第 1 层：最外层，24s，顺时针 -->
        <g class="layer layer1">
            <path d="M103.64988,250l146.35012,-146.35012l146.35012,146.35012l-146.35012,146.35012z"
                fill="url(#diamondFill)" fill-opacity="0.35" filter="url(#glow)"/>
            <path d="M103.64988,250l146.35012,-146.35012l146.35012,146.35012l-146.35012,146.35012z"
                fill="url(#diamondFill)" fill-opacity="0.75"/>
        </g>

        <!-- 第 2 层：16s，逆时针 -->
        <g class="layer layer2">
            <path d="M114.63595,250l135.36405,-135.36405l135.36405,135.36405l-135.36405,135.36405z"
                fill="url(#diamondFill2)" fill-opacity="0.35" filter="url(#glow)"/>
            <path d="M114.63595,250l135.36405,-135.36405l135.36405,135.36405l-135.36405,135.36405z"
                fill="url(#diamondFill2)" fill-opacity="0.78"/>
        </g>

        <!-- 第 3 层：10s，顺时针 -->
        <g class="layer layer3">
            <path d="M130.3501,250l119.6499,-119.6499l119.6499,119.6499l-119.6499,119.6499z"
                fill="url(#diamondFill)" fill-opacity="0.35" filter="url(#glow)"/>
            <path d="M130.3501,250l119.6499,-119.6499l119.6499,119.6499l-119.6499,119.6499z"
                fill="url(#diamondFill)" fill-opacity="0.82"/>
        </g>

        <!-- 第 4 层：最内层，6s，逆时针 -->
        <g class="layer layer4">
            <path d="M156.77653,250l93.22347,-93.22347l93.22347,93.22347l-93.22347,93.22347z"
                fill="#5eb2ff" fill-opacity="0.45" filter="url(#glow)"/>
            <path d="M156.77653,250l93.22347,-93.22347l93.22347,93.22347l-93.22347,93.22347z"
                fill="#7cc4ff" fill-opacity="0.95"/>
        </g>

    </g>
</svg>